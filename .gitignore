# Build output: app/ holds the published binaries beside the data folders
/app/*
!/app/rom/
!/app/ram/
!/app/drive-x/
!/app/manual/
!/app/README.txt
/app/rom/*.rom
/app/rom/*.ROM
/app/rom/*.bin
/app/ram/*.ram
/app/drive-x/*
!/app/drive-x/.gitkeep
/app/manual/images*/manual-shots.txt
/bin/
/tmp/
/backups/
/tests/__pycache__/
/tools/__pycache__/
/tests/output/
/tests/test-core.*
/src/desktop/bin/
/src/desktop/obj/
/src/cli/bin/
/src/cli/obj/
/src/native/*.obj
*.pdb
*.exp
*.lib
*.obj
/dist/
/src/avalonia/bin/
/src/avalonia/obj/
